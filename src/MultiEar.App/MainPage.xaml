<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MultiEar_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MultiEar_App"
    xmlns:vm="using:MultiEar_App.ViewModels"
    xmlns:naudio="using:NAudio.CoreAudioApi"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16,10,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Audio Advisory InfoBar -->
            <RowDefinition Height="Auto" />
            <!-- Device Cards or Empty State -->
            <RowDefinition Height="*" />
            <!-- Footer Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="8"
                        Width="36"
                        Height="36">
                    <FontIcon Glyph="&#xE7F6;"
                              FontSize="18"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="MultiEar" FontWeight="Bold" FontSize="16" />
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4"
                                Padding="5,1"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ActiveDevicesCountText, Mode=OneWay}"
                                       FontSize="10"
                                       FontWeight="Medium"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.DefaultDeviceName, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="190" />
                </StackPanel>
            </StackPanel>

            <!-- Global Mute Toggle Button -->
            <Button Grid.Column="1"
                    Click="OnToggleMuteClick"
                    VerticalAlignment="Center"
                    Padding="10,6"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="{x:Bind ViewModel.MuteButtonIcon, Mode=OneWay}" FontSize="13" />
                    <TextBlock Text="{x:Bind ViewModel.MuteButtonText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Advisory / Feedback InfoBar -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.HasFeedbackWarning, Mode=OneWay}"
                 Severity="Warning"
                 Title="Feedback Protection"
                 Message="{x:Bind ViewModel.FeedbackWarning, Mode=OneWay}"
                 CloseButtonClick="OnDismissWarningClick" />

        <!-- Main Content Area: Empty State OR Fluent Card Stack -->
        <Grid Grid.Row="2">
            <!-- Empty State Interactive Card -->
            <Border Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,32"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="28"
                            Width="56"
                            Height="56"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE7F6;"
                                  FontSize="26"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="No Earphones Connected"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Simultaneously stream your laptop audio to 2 or more Bluetooth headphones with automatic latency sync."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   MaxWidth="260" />
                    </StackPanel>
                    <Button Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Center"
                            Padding="16,8"
                            CornerRadius="6"
                            Click="OnOpenAddEarphoneDialogClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="Connect Earphones" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Active Fluent Cards List -->
            <ListView ItemsSource="{x:Bind ViewModel.Devices}"
                      SelectionMode="None"
                      Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceItemViewModel">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Row: Status Dot, Friendly Name, Codec Badge, Remove Button -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status dot -->
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{x:Bind StatusBrush, Mode=OneWay}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />

                                    <!-- Device Name & Status -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FriendlyName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Codec Pill Badge -->
                                    <Border Grid.Column="2"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Margin="6,0">
                                        <TextBlock Text="{x:Bind CodecDisplayName, Mode=OneWay}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>

                                    <!-- Remove Button -->
                                    <Button Grid.Column="3"
                                            Click="OnRemoveDeviceClick"
                                            DataContext="{x:Bind}"
                                            Padding="6,4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            ToolTipService.ToolTip="Remove earphone">
                                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>
                                </Grid>

                                <!-- Middle Row: Volume Slider with Icon and % -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE767;"
                                              FontSize="13"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Slider Grid.Column="1"
                                            Minimum="0"
                                            Maximum="150"
                                            Value="{x:Bind VolumePercent, Mode=TwoWay}"
                                            VerticalAlignment="Center"
                                            Margin="0" />
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind VolumeText, Mode=OneWay}"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!-- Bottom Row: Collapsible Tune Expander -->
                                <StackPanel Grid.Row="2" Spacing="8">
                                    <!-- Tune Expander Toggle Header -->
                                    <HyperlinkButton Click="OnToggleTuneExpandClick"
                                                     DataContext="{x:Bind}"
                                                     Padding="0"
                                                     HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="{x:Bind ExpandButtonGlyph, Mode=OneWay}" FontSize="9" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind ExpandButtonText, Mode=OneWay}" FontSize="11" FontWeight="Medium" />
                                        </StackPanel>
                                    </HyperlinkButton>

                                    <!-- Expanded Tune Drawer -->
                                    <Border Visibility="{x:Bind IsExpanded, Mode=OneWay}"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="0,2,0,0">
                                        <StackPanel Spacing="8">
                                            <!-- Codec Override & Total Sync Delay -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Codec:"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />

                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{x:Bind AvailableCodecs}"
                                                          SelectedItem="{x:Bind SelectedCodec, Mode=TwoWay}"
                                                          HorizontalAlignment="Left"
                                                          FontSize="11"
                                                          Padding="6,2"
                                                          MinHeight="24">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontSize="11" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <Border Grid.Column="2"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind TotalDelayText, Mode=OneWay}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- Manual Sync Fine-Trim Slider -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Trim:"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />

                                                <Slider Grid.Column="1"
                                                        Minimum="-100"
                                                        Maximum="100"
                                                        StepFrequency="5"
                                                        Value="{x:Bind ManualTrimMs, Mode=TwoWay}"
                                                        VerticalAlignment="Center"
                                                        Margin="0" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind ManualTrimText, Mode=OneWay}"
                                                           FontSize="11"
                                                           FontWeight="Medium"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0" />

                                                <Button Grid.Column="3"
                                                        Click="OnResetTrimClick"
                                                        DataContext="{x:Bind}"
                                                        Padding="4,2"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTipService.ToolTip="Reset trim to 0 ms">
                                                    <FontIcon Glyph="&#xE777;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Add Earphone Button -->
            <Button Grid.Column="0"
                    Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Padding="12,8"
                    CornerRadius="6"
                    Click="OnOpenAddEarphoneDialogClick">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                    <TextBlock Text="Add Earphone" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <!-- Settings / Diagnostics Flyout -->
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,8" CornerRadius="6">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <StackPanel Width="250" Spacing="10">
                            <TextBlock Text="MultiEar Audio Engine" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Automatic Codec Latency Alignment: Active" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Crystal Clock Drift Protection: Enabled" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Background System Tray: Active" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <MenuFlyoutSeparator />
                            <TextBlock Text="MultiEar v1.0.0 — Synchronized Multi-Bluetooth Audio" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- In-Window ContentDialog: Device Picker -->
        <ContentDialog x:Name="DevicePickerDialog"
                       Title="Add Bluetooth Earphone"
                       PrimaryButtonText="Done"
                       DefaultButton="Primary"
                       CloseButtonText="Cancel">
            <StackPanel Width="310" Spacing="12">
                <TextBlock Text="Select a paired audio device to include in the synchronized stream:"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />

                <!-- Discovered Audio Devices List -->
                <ListView ItemsSource="{x:Bind ViewModel.AvailableDevices}"
                          SelectionMode="None"
                          MaxHeight="260">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="naudio:MMDevice">
                            <Grid Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE7F6;"
                                          FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind FriendlyName}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="2"
                                        Content="Add"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        FontSize="11"
                                        Padding="12,3"
                                        Click="OnAddAvailableDeviceClick"
                                        DataContext="{x:Bind}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
